+    private static bool IsOwnedStoryBridge(List<ScriptGroupProject> projects, string groupName)
+    {
+        const string prefix = "AI-VTuber-Bridge-";
+        if (!groupName.StartsWith(prefix, StringComparison.Ordinal)
+            || !Guid.TryParseExact(groupName[prefix.Length..], "D", out var id)
+            || projects.Count != 1 || projects[0].Type != "Javascript"
+            || projects[0].FolderName != groupName)
+            return false;
+        try
+        {
+            var file = Global.Absolute(Path.Combine("User", "JsScript", groupName, "command.json"));
+            if (!File.Exists(file) || new FileInfo(file).Length > 8192) return false;
+            var command = Newtonsoft.Json.Linq.JObject.Parse(File.ReadAllText(file));
+            return command.Value<string>("operation") == "story"
+                && command.Value<string>("id") == id.ToString("D");
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+    }
