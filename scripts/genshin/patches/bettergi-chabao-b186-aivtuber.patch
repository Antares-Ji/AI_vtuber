diff --git a/BetterGenshinImpact/GameTask/AutoFight/Model/PartyRecoveryScope.cs b/BetterGenshinImpact/GameTask/AutoFight/Model/PartyRecoveryScope.cs
new file mode 100644
index 0000000..ea1a317
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/Model/PartyRecoveryScope.cs
@@ -0,0 +1,35 @@
+using System;
+using System.Collections.Generic;
+using System.Threading;
+
+namespace BetterGenshinImpact.GameTask.AutoFight.Model;
+
+// Scoped to the JSON fight task. Other tasks retain upstream recovery behavior.
+public sealed class PartyRecoveryScope : IDisposable
+{
+    private static readonly AsyncLocal<PartyRecoveryScope?> Slot = new();
+    public static PartyRecoveryScope? Current => Slot.Value;
+    private readonly PartyRecoveryScope? _previous;
+    private readonly HashSet<int> _defeated = new();
+    private int _pendingIndex;
+    private long _pendingAt;
+    public bool Enabled { get; }
+    public PartyRecoveryScope(bool enabled) { _previous=Slot.Value; Enabled=enabled; Slot.Value=this; }
+    public bool IsDefeated(int index) => Enabled && _defeated.Contains(index);
+    public void RecordSwitch(int index, long now) { _pendingIndex=index; _pendingAt=now; }
+    public void ConfirmSwitch() { _pendingIndex=0; }
+    public int RecordRevivePrompt(long now)
+    {
+        // A prompt without a recent switch is not evidence about the next action's avatar.
+        var index = now>=_pendingAt && now-_pendingAt<=3000 ? _pendingIndex : 0;
+        if (Enabled && index is >=1 and <=4) _defeated.Add(index);
+        _pendingIndex=0;
+        return index;
+    }
+    public void Dispose() { Slot.Value=_previous; }
+}
+
+public sealed class DefeatedAvatarException(int index) : Exception("单人复苏提示，跳过已确认阵亡角色")
+{
+    public int AvatarIndex { get; } = index;
+}
