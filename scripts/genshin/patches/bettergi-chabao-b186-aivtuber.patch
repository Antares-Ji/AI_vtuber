@@ -0,0 +1,60 @@
+using System;
+using System.Linq;
+using BetterGenshinImpact.Core.Recognition.OpenCv.FeatureMatch;
+
+// No BGI/OpenCV dependency, window capture, game resources, or input. This
+// harness decides whether geometric evidence may authorize the JS direction
+// check; passing it does not establish live icon detection or arrival.
+var count = 0;
+void Check(bool condition, string name)
+{
+    if (!condition) throw new Exception(name);
+    count++; Console.WriteLine("PASS " + name);
+}
+OwnedProjectionPoint[] Grid() => (from x in new[] { 35d, 80d, 125d, 170d }
+    from y in new[] { 35d, 100d, 165d } select new OwnedProjectionPoint(x, y)).ToArray();
+double[] Rotation(double angle)
+{
+    var r = angle * Math.PI / 180;
+    return [2 * Math.Cos(r), -2 * Math.Sin(r), 2000, 2 * Math.Sin(r), 2 * Math.Cos(r), 2000, 0, 0, 1];
+}
+OwnedProjectionQuality Evaluate(double[] h, OwnedProjectionPoint[]? points = null,
+    OwnedProjectionPoint? marker = null, bool[]? inliers = null, double error = 0)
+{
+    var source = points ?? Grid();
+    var destination = source.Select(p => OwnedProjectionGeometry.Project(h, p) ?? new(0, 0))
+        .Select(p => new OwnedProjectionPoint(p.X + error, p.Y)).ToArray();
+    return OwnedProjectionGeometry.Evaluate(h, source, destination,
+        inliers ?? source.Select(_ => true).ToArray(), 212, 212, marker ?? new(180, 106), 10000, 10000);
+}
+foreach (var degrees in new[] { 0d, 30d, 90d, 180d, 270d })
+{
+    var q = Evaluate(Rotation(degrees)); var r = degrees * Math.PI / 180;
+    Check(q.Ok && Math.Abs(q.GameDirection!.X + Math.Cos(r)) < 1e-8
+        && Math.Abs(q.GameDirection.Y + Math.Sin(r)) < 1e-8, "rotation " + degrees + " negative image vector");
+}
+foreach (var (marker, x, y) in new[] {
+    (new OwnedProjectionPoint(180,106), -1d, 0d), (new OwnedProjectionPoint(106,180), 0d, -1d),
+    (new OwnedProjectionPoint(32,106), 1d, 0d), (new OwnedProjectionPoint(106,32), 0d, 1d) })
+{
+    var q = Evaluate(Rotation(0), marker: marker);
+    Check(q.Ok && Math.Abs(q.GameDirection!.X - x) < 1e-8 && Math.Abs(q.GameDirection.Y - y) < 1e-8,
+        "cardinal " + marker);
+}
+Check(Evaluate(Rotation(0), points: Grid()[..9]).Reason == "insufficient_inliers", "reject too few matches");
+Check(Evaluate(Rotation(0), inliers: Grid().Select((_, i) => i < 9).ToArray()).Reason == "insufficient_inliers", "reject insufficient consensus");
+var line = Enumerable.Range(0, 12).Select(i => new OwnedProjectionPoint(25 + i * 14, 25 + i * 14)).ToArray();
+Check(Evaluate(Rotation(0), points: line).Reason == "degenerate_inlier_geometry", "reject collinear inliers");
+var cluster = Grid().Select(p => new OwnedProjectionPoint(p.X / 10 + 95, p.Y / 10 + 95)).ToArray();
+Check(Evaluate(Rotation(0), points: cluster).Reason == "insufficient_spread", "reject tiny coverage");
+Check(Evaluate(Rotation(0), error: 4).Reason == "reprojection_error", "reject inconsistent homography");
+Check(Evaluate([-2, 0, 2000, 0, 2, 2000, 0, 0, 1]).Reason == "reflected_or_singular_homography", "reject reflected map");
+Check(Evaluate([8, 0, 2000, 0, 8, 2000, 0, 0, 1]).Reason == "implausible_scale_or_shear", "reject excessive scale");
+Check(Evaluate([2, 1, 2000, 0, 2, 2000, 0, 0, 1]).Reason == "implausible_scale_or_shear", "reject shear");
+Check(!Evaluate([2, 0, 2000, 0, 2, 2000, 0.008, 0, 1]).Ok, "reject perspective distortion");
+Check(Evaluate(Rotation(0), marker: new(106, 106)).Reason == "marker_outside_minimap_or_at_center", "reject center candidate");
+Check(Evaluate(Rotation(0), marker: new(10, 10)).Reason == "marker_outside_minimap_or_at_center", "reject square corner outside circle");
+Check(Evaluate([2, 0, -1000, 0, 2, -1000, 0, 0, 1]).Reason == "projection_outside_map", "reject projection outside map");
+Check(OwnedProjectionGeometry.Project([1,0,0,0,1,0,0,0,0], new(100,100)) == null, "reject homogeneous divide by zero");
+Check(OwnedProjectionGeometry.Project([double.NaN,0,0,0,1,0,0,0,1], new(100,100)) == null, "reject nonfinite H");
+Console.WriteLine($"{count} geometry assertions passed; no live observation or game input performed.");
