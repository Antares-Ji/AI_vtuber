PORT=3000
HOST=127.0.0.1
CHARACTER_PACK=luotianyi
# Optional override for the editable character world-book text file.
LUOTIANYI_WORLD_BOOK_PATH=
BRAIN_REPETITION_BOUNDARY=0.42
BRAIN_SOCIAL_PERCEPTION_CONFIDENCE=0.55
BRAIN_MEMORY_MIN_RELEVANCE=0.10
BRAIN_REPLY_DUPLICATE_JACCARD=0.78
SCENE_CHAT_MIN_DELAY_MS=60000
SCENE_CHAT_MAX_DELAY_MS=90000

# Optional. DeepSeek uses an OpenAI-compatible chat completions API.
# Keep your real key only in .env.local, never in this template.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Two-layer brain: Qwen handles fast everyday chat, DeepSeek handles complex work.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_LLM_MODEL=qwen3.5-4b
LOCAL_LLM_TIMEOUT_MS=12000
QWEN_MODEL_PATH=E:\Qwen3.5-4B

# Browser TTS is the default. Change to gpt-sovits after its local service is ready.
TTS_PROVIDER=browser-speech-synthesis
TTS_VOICE_HINT=zh

GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_REF_AUDIO=
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_PROMPT_LANG=zh
# 可选：为不同情绪提供各自合法授权的 3-10 秒参考音频与对应原文。
# 未配置的情绪会自动回退到上面的默认参考音频。
GPT_SOVITS_REF_AUDIO_HAPPY=
GPT_SOVITS_PROMPT_TEXT_HAPPY=
GPT_SOVITS_REF_AUDIO_SHY=
GPT_SOVITS_PROMPT_TEXT_SHY=
GPT_SOVITS_REF_AUDIO_FOCUSED=
GPT_SOVITS_PROMPT_TEXT_FOCUSED=
GPT_SOVITS_REF_AUDIO_CONCERNED=
GPT_SOVITS_PROMPT_TEXT_CONCERNED=

GPT_SOVITS_TEXT_LANG=zh
GPT_SOVITS_TOP_K=12
GPT_SOVITS_TOP_P=0.82
GPT_SOVITS_TEMPERATURE=0.65
GPT_SOVITS_REPETITION_PENALTY=1.2
GPT_SOVITS_SPEED=1.08
GPT_SOVITS_FRAGMENT_INTERVAL=0.04
GPT_SOVITS_STREAMING_MODE=3
GPT_SOVITS_FIXED_LENGTH_CHUNK=true
GPT_SOVITS_MIN_CHUNK_LENGTH=12
GPT_SOVITS_SEED=-1

# Local SenseVoice/FunASR speech recognition service.
ASR_PROVIDER=funasr-local
ASR_BASE_URL=http://127.0.0.1:10095
ASR_MODEL=iic/SenseVoiceSmall
ASR_FFMPEG_PATH=
ASR_DEVICE=cuda:0

# Singing is a separate pipeline from speech TTS. It remains disabled until
# a legal model, engine endpoint, and authorized catalog entries are ready.
SINGING_PROVIDER=disabled
SINGING_BASE_URL=
SINGING_MODEL_PATH=
# 只填写合同/许可记录编号，不放歌词正文。
SINGING_VOICE_AUTHORIZATION_REFERENCE=

# This local-preview model must not be used for commercial streaming.
LIVE2D_MODEL_PATH=/live2d-web/miku-web.model3.json

# Optional OBS WebSocket 5.x connection. Enable WebSocket in OBS first.
OBS_WEBSOCKET_ENABLED=false
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Reserved for Bilibili's official live-open platform credentials.
# Until configured, /api/live/bilibili-event remains available for adapter testing.
BILIBILI_ACCESS_KEY_ID=
BILIBILI_ACCESS_KEY_SECRET=
# Optional RTX 5070 worker discovery. Keep the main server bound to 127.0.0.1
# until a strong shared token and Windows firewall rules are configured.
WORKER_SHARED_TOKEN=
WORKER_HEARTBEAT_TTL_MS=15000
