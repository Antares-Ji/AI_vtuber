.env
.env.local
# Private voice profiles and trained weights are delivered separately.
config/voices/*.local.json
*.ckpt
*.pth

# Local user data and runtime state
/runtime/
data/memory.db*
data/memories.json
data/memories.pre-sqlite.json
data/brain-runtime.json
data/training-memories.json
data/story-state.json
data/osu-observations.json
data/runtime-settings.json
data/minecraft-engine.local.json*
data/sts2/
data/singing-catalog.json

# Voice references may contain licensed or personally identifiable audio.
assets/tts/*.wav
assets/tts/*.mp3
assets/tts/*.m4a
assets/tts/*.flac

# Node modules and third-party clones (not project source)
node_modules/
third_party/
/vendor/maa/

# Python build artifacts
__pycache__/
*.pyc
.venv/

# Vision runtime artifacts (generated images are fixtures and stay tracked)
runtime/vision/incoming/
runtime/vision-env/

# Runtime logs (not source)
logs/

# Generated handoff bundles and raw training recordings stay local.
/output/*.zip
/output/*.manifest.json
/output/*.sha256.txt
/video/*.mp4
# Generated live tactics snapshots (source scripts are versioned).
/public/sts2-tactics.json
/public/sts2-tactics-status.json
