{
  "name": "codex_neurosama",
  "version": "1.0.0",
  "description": "Live2D AI streamer MVP with persona, emotion, memory, mock danmaku, and pluggable LLM/TTS.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node src/smoke-test.js",
    "test:memory": "node src/memory-stress-test.js",
    "test:advanced": "node src/advanced-evaluation.js",
    "test:runtime": "node src/runtime-recovery-test.js",
    "test:robustness": "node src/robustness-test.js",
    "test:emotion": "node src/emotion-evaluation.js",
    "test:character": "node src/character-independence-test.js",
    "test:curriculum": "node src/curriculum-evaluation.js",
    "test:external": "node src/external-evaluation.js",
    "train:auto": "node scripts/auto-train.js",
    "train:clean": "node scripts/clean-duplicate-memories.js",
    "vision:fixtures": "runtime\\vision-env\\Scripts\\python.exe tests/vision/generate-fixtures.py",
    "vision:arknights:text": "node scripts/arknights-text-click.js",
    "test:vision:py": "runtime\\vision-env\\Scripts\\python.exe -m unittest discover -s tests/vision -p \"test_*.py\"",
    "test:vision:node": "node tests/vision/test_session_tracker.js && node tests/vision/test_training_analyzer.js && node tests/vision/test_provider.js",
    "test:vision:integration": "node tests/vision/test_session_integration.js && node tests/vision/test_multi_session_trend.js",
    "test:vision:concurrency": "node tests/vision/test-concurrency.js",
    "test:vision:perf": "node tests/vision/perf-analyze.js",
    "test:vision": "npm run test:vision:py && npm run test:vision:node && npm run test:vision:integration && npm run test:vision:concurrency",
    "test:all": "npm test && npm run test:advanced && npm run test:curriculum && npm run test:emotion && npm run test:character && npm run test:memory && npm run test:runtime && npm run test:robustness && npm run test:vision"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "live2dcubismcore": "^1.0.2",
    "obs-websocket-js": "^5.0.8",
    "pixi.js": "^8.13.1",
    "untitled-pixi-live2d-engine": "^1.3.5"
  }
}
